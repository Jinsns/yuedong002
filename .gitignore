# Xcode 用户数据（本地配置，不应共享）
xcuserdata/
*.xcuserstate
*.xcuserdatad/

# Xcode 工作空间设置（本地配置）
*.xcworkspace/xcshareddata/WorkspaceSettings.xcsettings
*.xcworkspace/xcuserdata/

# macOS 系统文件
.DS_Store
**/.DS_Store

# 编译产物
build/
DerivedData/
*.ipa
*.dSYM.zip
*.dSYM

# 依赖管理
Pods/
Podfile.lock
*.swiftpm/
Package.resolved

# 临时文件
*.tmp
*.temp
*~

# 敏感信息
*.env
*.secret
*.key
*.pem
credentials*